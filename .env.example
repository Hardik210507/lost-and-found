# ===================================================================
# Supabase PostgreSQL Configuration
# ===================================================================
# You can find these details in your Supabase Dashboard:
# Project -> Project Settings -> Database -> Connection string -> JDBC / URI

# Option 1: Direct Connection (Port 5432)
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Option 2: Connection Pooler / Supavisor (Port 6543 or 5432 - recommended if your network doesn't support IPv6)
# SUPABASE_DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
# SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
